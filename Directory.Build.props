<?xml version="1.0" encoding="utf-8"?>
<Project>
  <!-- Security policy for the IntegrationTests and samples solutions. The src tree has its own
       Directory.Build.props (which already sets TreatWarningsAsErrors), so MSBuild stops there and
       this file does not apply to it. Audit the full transitive dependency graph and turn any
       moderate-or-higher vulnerability advisory into a build error, so CI cannot report success
       while a known-vulnerable package is referenced. -->
  <PropertyGroup>
    <NuGetAudit>true</NuGetAudit>
    <NuGetAuditMode>all</NuGetAuditMode>
    <WarningsAsErrors>$(WarningsAsErrors);NU1902;NU1903;NU1904</WarningsAsErrors>
  </PropertyGroup>
  <!-- Sample.Tests uses Verify, whose SponsorCheck fails the build (SC021) unless one of its licence
       properties is set, and then warns (SC023) that the licence is being ignored.
       src/Directory.Build.props carries the same pair for Scry.Tests; because MSBuild stops walking
       at that file, the two trees each need their own copy. -->
  <PropertyGroup>
    <Verify_SponsorshipLicenseIgnored>true</Verify_SponsorshipLicenseIgnored>
    <NoWarn>$(NoWarn);SC023</NoWarn>
  </PropertyGroup>
</Project>
