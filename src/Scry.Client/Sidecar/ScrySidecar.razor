@namespace Scry
@inject ScrySidecarStore Store
@inject ScrySidecarOptions Options
@inject IJSRuntime JS
@inject IServiceProvider Services

@if (ShowsLauncher)
{
    <button type="button"
            class="scry-sidecar-launcher"
            data-testid="sidecar-toggle"
            title="Open the Scry sidecar (@Options.ToggleShortcut)"
            aria-label="Open the Scry debug sidecar"
            @onclick="Toggle">Scry</button>
}
@if (open)
{
    <aside class="scry-sidecar" data-testid="sidecar" role="complementary" aria-label="Scry debug sidecar">
        <header class="scry-sidecar-header">
            <h2>Scry <span class="scry-sidecar-count" data-testid="sidecar-count">@Store.Entries.Count</span></h2>
            <button type="button" data-testid="sidecar-clear" title="Forget every captured exchange" @onclick="Clear">Clear</button>
            <button type="button" data-testid="sidecar-close" title="Hide the sidecar (@Options.ToggleShortcut)" @onclick="Toggle">Close</button>
        </header>
        <div class="scry-sidecar-body">
            @if (Empty)
            {
                <p class="scry-sidecar-empty" data-testid="sidecar-empty">No Scry exchanges captured yet.</p>
            }
            else
            {
                <ol class="scry-sidecar-entries" data-testid="sidecar-entries">
                    @foreach (var entry in Store.Entries)
                    {
                        <li @key="entry.Id">
                            @if (entry.Session is { } session)
                            {
                                <div class="scry-sidecar-row @Chosen(entry.Id, attempt: null)"
                                     data-testid="sidecar-session"
                                     @onclick="() => Select(entry.Id)">
                                    <button type="button"
                                            class="scry-sidecar-caret"
                                            data-testid="sidecar-expand"
                                            title="@CaretTitle(entry.Id)"
                                            aria-expanded="@Expanded(entry.Id)"
                                            @onclick="() => Expand(entry.Id)"
                                            @onclick:stopPropagation="true">@Caret(entry.Id)</button>
                                    <span class="@KindClass(session)">@entry.Kind</span>
                                    <span>@entry.Method</span>
                                    <span class="scry-sidecar-name">@Name(entry)</span>
                                    <span class="@StateClass(session)" data-testid="sidecar-session-state">@Progress(session)</span>
                                    <span class="scry-sidecar-duration"
                                          data-testid="sidecar-session-counts"
                                          title="@Tally(session)">@Counts(session)</span>
                                </div>
                                @if (Expanded(entry.Id))
                                {
                                    <ol class="scry-sidecar-connections" data-testid="sidecar-connections">
                                        @foreach (var connection in Newest(session))
                                        {
                                            <li @key="connection.Attempt"
                                                class="scry-sidecar-row @Chosen(entry.Id, connection.Attempt)"
                                                data-testid="sidecar-connection"
                                                @onclick="() => Select(entry.Id, connection.Attempt)">
                                                <span class="scry-sidecar-name">@ConnectionName(connection)</span>
                                                <span>@StatusText(connection)</span>
                                                <span class="scry-sidecar-duration">@Finish(connection)</span>
                                            </li>
                                        }
                                    </ol>
                                }
                            }
                            else
                            {
                                <div class="scry-sidecar-row @Chosen(entry.Id, attempt: null)" @onclick="() => Select(entry.Id)">
                                    <span class="scry-sidecar-kind">@entry.Kind</span>
                                    <span>@entry.Method</span>
                                    <span class="scry-sidecar-name">@Name(entry)</span>
                                    @if (entry.Command is { } command)
                                    {
                                        <span class="@CommandClass(command)" data-testid="sidecar-command-state">@CommandState(command)</span>
                                    }
                                    else
                                    {
                                        <span class="@ErrorClass(entry)">@StatusText(entry)</span>
                                    }
                                    <span class="scry-sidecar-duration">@Milliseconds(entry) ms</span>
                                </div>
                            }
                        </li>
                    }
                </ol>
                @if (Selected is { } selected)
                {
                    <div class="scry-sidecar-detail" data-testid="sidecar-detail">
                        @if (HasUrl(selected))
                        {
                            <h3>URL</h3>
                            <p class="scry-sidecar-url" data-testid="sidecar-url">@selected.Url</p>
                        }
                        <div class="scry-sidecar-actions">
                            @if (HasUrl(selected))
                            {
                                <button type="button" data-testid="sidecar-copy-url" title="Copy the request URL" @onclick="() => Copy(selected.Url)">Copy URL</button>
                            }
                            @if (selected.RequestJson is { } requestJson)
                            {
                                <button type="button" data-testid="sidecar-copy-request" title="Copy the wire request JSON" @onclick="() => Copy(requestJson)">Copy request</button>
                            }
                            @if (ExplorerHref(selected) is { } href)
                            {
                                <a data-testid="sidecar-explorer-link" href="@href" target="_blank" rel="noopener" title="Open this query in the explorer, in a new tab">Open in explorer</a>
                            }
                            @if (Downloadable(selected))
                            {
                                <button type="button" data-testid="sidecar-download" title="Re-send the attachment request and save the bytes" @onclick="() => Download(selected)">Download</button>
                            }
                        </div>
                        @if (note is not null)
                        {
                            <p class="scry-sidecar-note" data-testid="sidecar-note">@note</p>
                        }
                        @if (Failure(selected) is { } error)
                        {
                            <p class="scry-sidecar-error" data-testid="sidecar-error">@error</p>
                        }
                        @if (SelectedConnection is { } connection)
                        {
                            <h3>Connection @connection.Attempt</h3>
                            <p class="scry-sidecar-note" data-testid="sidecar-connection-summary">@Summary(connection)</p>
                            <h3>Events</h3>
                            <table data-testid="sidecar-events">
                                <tbody>
                                @foreach (var captured in Listed(connection))
                                {
                                    <tr class="@EventClass(captured)"
                                        @onclick="() => Show(captured)">
                                        <th>@captured.Name</th>
                                        <td class="scry-sidecar-event-id">@captured.EventId</td>
                                        <td class="scry-sidecar-duration">@Size(captured.Bytes)</td>
                                        <td class="scry-sidecar-duration">@Time(captured)</td>
                                    </tr>
                                }
                                </tbody>
                            </table>
                            @if (DroppedNote(connection) is { } dropped)
                            {
                                <p class="scry-sidecar-note">@dropped</p>
                            }
                            @if (ShownEvent is { } shown)
                            {
                                <h3>@shown.Name</h3>
                                <pre data-testid="sidecar-event-data">@shown.Json</pre>
                            }
                            <h3>Response headers</h3>
                            <table data-testid="sidecar-response-headers">
                                <tbody>
                                @foreach (var header in connection.ResponseHeaders)
                                {
                                    <tr><th>@header.Key</th><td>@header.Value</td></tr>
                                }
                                </tbody>
                            </table>
                        }
                        else
                        {
                            @if (selected.Command is { } sent)
                            {
                                <h3>Command</h3>
                                <p class="scry-sidecar-note" data-testid="sidecar-command-summary">@Summary(sent)</p>
                                @if (sent.ResultJson is { } result)
                                {
                                    <h3>Result</h3>
                                    <pre data-testid="sidecar-command-result">@result</pre>
                                }
                            }
                            @if (selected.Session is { } live)
                            {
                                <h3>Live query</h3>
                                <p class="scry-sidecar-note" data-testid="sidecar-session-summary">@Summary(live)</p>
                                @if (live.LatestAnswer is { } latest)
                                {
                                    <h3>Latest answer</h3>
                                    <pre data-testid="sidecar-latest-answer">@latest</pre>
                                }
                            }
                            @if (HasRequestHeaders(selected))
                            {
                                <h3>Request headers</h3>
                                <table data-testid="sidecar-request-headers">
                                    <tbody>
                                    @foreach (var header in selected.RequestHeaders)
                                    {
                                        <tr><th>@header.Key</th><td>@header.Value</td></tr>
                                    }
                                    </tbody>
                                </table>
                            }
                            @if (selected.RequestJson is { } request)
                            {
                                <h3>Request</h3>
                                <pre data-testid="sidecar-request">@request</pre>
                            }
                            @if (selected.Session is null)
                            {
                                <h3>Response headers</h3>
                                <table data-testid="sidecar-response-headers">
                                    <tbody>
                                    @foreach (var header in selected.ResponseHeaders)
                                    {
                                        <tr><th>@header.Key</th><td>@header.Value</td></tr>
                                    }
                                    </tbody>
                                </table>
                                @if (selected.ResponseJson is { } response)
                                {
                                    <h3>Response</h3>
                                    <pre data-testid="sidecar-response">@response</pre>
                                }
                                else if (BodyNotCaptured(selected))
                                {
                                    <p class="scry-sidecar-note">Body not captured — @NotCaptured(selected.Kind).</p>
                                }
                                @if (HasBinaryParts(selected))
                                {
                                    <h3>Binary parts</h3>
                                    <table data-testid="sidecar-binary-parts">
                                        <tbody>
                                        @foreach (var part in BinaryParts(selected))
                                        {
                                            <tr><th>$bin @part.Index</th><td>@part.Bytes bytes</td></tr>
                                        }
                                        </tbody>
                                    </table>
                                }
                            }
                        }
                    </div>
                }
            }
        </div>
    </aside>
}
