<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <RootNamespace>Scry</RootNamespace>
    <TargetFramework>net10.0</TargetFramework>
    <PackageReadmeFile>nuget-readme.md</PackageReadmeFile>
  </PropertyGroup>
  <ItemGroup>
    <!-- The explorer reads the same multipart responses this client does, and reading the format two
         ways is how the two would come to disagree about it. Nothing public is added for it: the
         vendored reader stays internal and the explorer is in-tree, not shipped. The key is this
         tree's own src/key.snk, which Scry.Explorer.Core is signed with — a friend of a strong-named
         assembly has to be named by key, not by name alone. -->
    <InternalsVisibleTo Include="Scry.Explorer.Core" Key="$(ScryPublicKey)" />
    <!-- The ndjson line reader hands back memory into its own buffer, so what it does across a refill,
         at a line longer than that buffer, and at a stream that ends without a newline is worth testing
         directly rather than only through a stream that happens to produce those. -->
    <InternalsVisibleTo Include="Scry.Tests" Key="$(ScryPublicKey)" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
    <PackageReference Include="Polyfill" PrivateAssets="all" />
    <PackageReference Include="ProjectDefaults" PrivateAssets="all" />
    <ProjectReference Include="..\Scry.Wire\Scry.Wire.csproj" />
    <ProjectReference Include="..\Scry.SourceGenerator\Scry.SourceGenerator.csproj"
                      OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
    <None Include="..\Scry.SourceGenerator\bin\$(Configuration)\netstandard2.0\Scry.SourceGenerator.dll"
          Pack="true" PackagePath="analyzers/dotnet/roslyn5.0/cs" Visible="false" />
    <None Include="..\Scry.SourceGenerator\bin\$(Configuration)\net10.0\Scry.SourceGenerator.dll"
          Pack="true" PackagePath="analyzers/dotnet/roslyn5.3/cs" Visible="false" />
    <None Include="buildTransitive\Scry.Client.props" Pack="true" PackagePath="buildTransitive\" />
    <None Include="buildTransitive\Scry.Client.props" Pack="true" PackagePath="build\" />
    <None Include="nuget-readme.md" Pack="true" PackagePath="\" />
  </ItemGroup>
  <!-- The generator multi-targets (netstandard2.0;net10.0) and we pack both flavours, but the
       ProjectReference above only forces the net10.0 inner build (TFM negotiation picks the flavour
       compatible with this net10.0 project). Build the generator's outer build so the netstandard2.0
       DLL exists before pack — regardless of solution build vs. direct dotnet pack. -->
  <Target Name="BuildSourceGeneratorAllTfms" BeforeTargets="Build;Pack">
    <MSBuild Projects="..\Scry.SourceGenerator\Scry.SourceGenerator.csproj"
             Properties="Configuration=$(Configuration)" />
  </Target>
</Project>
