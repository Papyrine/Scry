<?xml version="1.0" encoding="utf-8"?>
<Project>
  <PropertyGroup>
    <NoWarn>CS1591;NU1608;NU1109;SC023;PolyfillTargetsForNuget</NoWarn>
    <Version>0.1.0-beta.6</Version>
    <LangVersion>14.0</LangVersion>
    <AssemblyVersion>1.0.0</AssemblyVersion>
    <Description>Scry lets a Blazor client write strongly-typed LINQ against a server-side EF Core model, serialize it, and execute it server-side with allow-list enforcement.</Description>
    <ResolveAssemblyReferencesSilent>true</ResolveAssemblyReferencesSilent>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <!-- Audit the full transitive dependency graph. Combined with TreatWarningsAsErrors this fails
         the build on any package vulnerability advisory (e.g. NU1903). -->
    <NuGetAuditMode>all</NuGetAuditMode>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <SuppressNETCoreSdkPreviewMessage>true</SuppressNETCoreSdkPreviewMessage>
    <ScryPublicKey></ScryPublicKey>
    <Verify_SponsorshipLicenseIgnored>true</Verify_SponsorshipLicenseIgnored>
  </PropertyGroup>
</Project>
