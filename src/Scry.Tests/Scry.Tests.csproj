<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <!-- The snapshot scrubbers, shared with Sample.Tests: they keep the same unrelated churn out of
         both projects' verified files, and two copies would eventually stop agreeing on what churn is. -->
    <Compile Include="..\Shared\SnapshotScrubbers.cs" Link="SnapshotScrubbers.cs" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="NUnit" />
    <PackageReference Include="NUnit3TestAdapter" />
    <PackageReference Include="Verify.NUnit" />
    <PackageReference Include="Verify.DiffPlex" />
    <PackageReference Include="NaughtyStrings" />
    <PackageReference Include="EfLocalDb" />
    <PackageReference Include="ProjectDefaults" PrivateAssets="all" />
    <!-- Merges snippets from source into the markdown under /docs. Building this project
         regenerates /readme.md and /docs/*.md from their .source.md counterparts. -->
    <PackageReference Include="MarkdownSnippets.MsBuild" PrivateAssets="all" />
    <PackageReference Include="DiffEngine" />
    <ProjectReference Include="..\Scry.Wire\Scry.Wire.csproj" />
    <ProjectReference Include="..\Scry.Annotations\Scry.Annotations.csproj" />
    <ProjectReference Include="..\Scry.Server\Scry.Server.csproj" />
    <ProjectReference Include="..\Scry.Client\Scry.Client.csproj" />
    <!-- Referenced as a library, not as an analyzer: LockstepTests runs its metadata reader over this
         project's own model assembly and compares the stamp it computes with the server's. It also
         supplies SupportedLinq, the closed LINQ surface the analyzer reports against, which
         SupportedLinqTests pins against KnownFunction and against Queryable itself — neither of
         which the analyzer's own assembly can see. -->
    <ProjectReference Include="..\Scry.SourceGenerator\Scry.SourceGenerator.csproj" />
  </ItemGroup>
</Project>
