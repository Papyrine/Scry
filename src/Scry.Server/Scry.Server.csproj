<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <RootNamespace>Scry</RootNamespace>
    <TargetFramework>net10.0</TargetFramework>
    <PackageReadmeFile>nuget-readme.md</PackageReadmeFile>
  </PropertyGroup>
  <ItemGroup>
    <!-- The stamp must be byte-identical between generated clients and the server; both compile the
         same shared source. Which source names are expressible is shared for the same reason: the
         generator refuses to emit one it cannot write, so the server has to refuse the same set. -->
    <Compile Include="..\Shared\SchemaStamp.cs" Link="SchemaStamp.cs" />
    <Compile Include="..\Shared\SensitiveWalk.cs" Link="SensitiveWalk.cs" />
    <Compile Include="..\Shared\CSharpIdentifier.cs" Link="CSharpIdentifier.cs" />
  </ItemGroup>
  <ItemGroup>
    <!-- The buffer writer, the multipart framing and the cursor codec are each exercised through the
         endpoint by the tests above them, but their edge cases — a buffer grown past its rented size,
         a cached part header, a cursor whose base64url carries the substituted characters — are worth
         reaching directly rather than contriving a request that happens to hit them. Named by key for
         the reason given on Scry.Client's friend. -->
    <InternalsVisibleTo Include="Scry.Tests" Key="$(ScryPublicKey)" />
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <PackageReference Include="Microsoft.EntityFrameworkCore" />
    <PackageReference Include="Polyfill" PrivateAssets="all" />
    <PackageReference Include="ProjectDefaults" PrivateAssets="all" />
    <ProjectReference Include="..\Scry.Wire\Scry.Wire.csproj" />
    <ProjectReference Include="..\Scry.Annotations\Scry.Annotations.csproj" />
    <None Include="nuget-readme.md" Pack="true" PackagePath="\" />
  </ItemGroup>
</Project>
