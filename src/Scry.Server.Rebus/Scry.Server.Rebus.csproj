<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <RootNamespace>Scry</RootNamespace>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <PackageReadmeFile>nuget-readme.md</PackageReadmeFile>
    <Description>Carries Scry commands over Rebus: a command a client sends is sent to the handler that handles it, and its outcome comes back to the client when the handler replies.</Description>
  </PropertyGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Scry.Server.Bus.Tests" Key="$(ScryPublicKey)" />
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <PackageReference Include="Rebus" />
    <PackageReference Include="ProjectDefaults" PrivateAssets="all" />
    <ProjectReference Include="..\Scry.Server\Scry.Server.csproj" />
    <None Include="nuget-readme.md" Pack="true" PackagePath="\" />
  </ItemGroup>
</Project>
