<?xml version="1.0" encoding="utf-8"?>
<Project>
  <!--
    Wires the Skry source generator. A consuming project only needs to:
      1. Set <SkryModelDll> to the path of the server model's built DLL.
      2. Add a <ProjectReference ... ReferenceOutputAssembly="false" /> to the model project for
         build ordering (NOT a real reference).
    This props file surfaces the path to the generator and folds the DLL's content hash into a
    compiler-visible property so the generator re-reads it exactly when the model changes.
  -->
  <ItemGroup>
    <CompilerVisibleProperty Include="SkryModelDll" />
    <CompilerVisibleProperty Include="SkryModelStamp" />
  </ItemGroup>

  <Target Name="ComputeSkryStamp"
          AfterTargets="ResolveProjectReferences"
          BeforeTargets="GenerateMSBuildEditorConfig;CoreCompile"
          Condition="'$(SkryModelDll)' != '' and Exists('$(SkryModelDll)')">
    <GetFileHash Files="$(SkryModelDll)" Algorithm="SHA256">
      <Output TaskParameter="Hash" PropertyName="SkryModelStamp" />
    </GetFileHash>
  </Target>

  <Target Name="EnsureSkryModel"
          BeforeTargets="CoreCompile"
          Condition="'$(SkryModelDll)' != '' and !Exists('$(SkryModelDll)')">
    <Error Text="Skry: the model assembly '$(SkryModelDll)' was not found. Ensure the model project is referenced with ReferenceOutputAssembly=&quot;false&quot; so it builds first." />
  </Target>
</Project>
