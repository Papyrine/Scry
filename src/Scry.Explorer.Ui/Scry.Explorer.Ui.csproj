<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <!-- The explorer hosts Roslyn, which reads plain PE assemblies and needs the IL interpreter for
         QueryTranslator's Expression.Compile(). Disable Webcil so the app's own assemblies stay
         readable, and keep AOT off so the interpreter is present. -->
    <WasmEnableWebcil>false</WasmEnableWebcil>
    <RunAOTCompilation>false</RunAOTCompilation>
    <!-- Roslyn is reflection/MEF heavy; trimming strips it. A dev tool can afford the larger payload. -->
    <PublishTrimmed>false</PublishTrimmed>
    <!-- Stable _framework filenames so the executor can fetch Scry.Client.dll / Scry.Wire.dll as
         Roslyn metadata references for compiling + running the user's query. -->
    <WasmFingerprintAssets>false</WasmFingerprintAssets>
    <!-- The explorer is English-only; don't ship localized BCL/Roslyn resource assemblies in the
         published WASM (smaller embed, and no spurious satellites for the packaging project). -->
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.DevServer" PrivateAssets="all" />
    <PackageReference Include="BlazorMonaco" />
    <ProjectReference Include="..\Scry.Explorer.Core\Scry.Explorer.Core.csproj" />
    <ProjectReference Include="..\Scry.Wire\Scry.Wire.csproj" />
  </ItemGroup>
</Project>
