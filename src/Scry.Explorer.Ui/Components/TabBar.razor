@namespace Scry

<div class="tabs" role="tablist" data-testid="tabs" aria-label="Query tabs">
    @foreach (var (index, tab) in Indexed())
    {
        <div class="@TabClass(index)" role="tab" aria-selected="@Selected(index)" @key="tab.Id">
            @if (Renaming(index))
            {
                <input class="tab-rename"
                       data-testid="tab-rename"
                       @ref="renameInput"
                       @bind="renameText"
                       @bind:event="oninput"
                       @onkeydown="_ => OnRenameKey(_, index)"
                       @onblur="CancelRename" />
            }
            else
            {
                <button type="button"
                        class="tab-button"
                        data-testid="tab"
                        title="@Store.Title(tab)"
                        @onclick="() => OnActivate.InvokeAsync(index)"
                        @ondblclick="() => StartRename(index)">@Store.Title(tab)</button>
                @* The close goes with the second tab: an explorer with no tab has nowhere to type. *@
                @if (Closable)
                {
                    <button type="button"
                            class="tab-close"
                            data-testid="tab-close"
                            aria-label="Close tab"
                            title="Close tab"
                            @onclick="() => OnClose.InvokeAsync(index)">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"
                             stroke-linecap="round" aria-hidden="true" focusable="false">
                            <path d="M6 6l12 12M18 6L6 18" />
                        </svg>
                    </button>
                }
            }
        </div>
    }
    <button type="button" class="tab-add" data-testid="tab-add" aria-label="New tab" title="New tab"
            @onclick="() => OnAdd.InvokeAsync()">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"
             stroke-linecap="round" aria-hidden="true" focusable="false">
            <path d="M12 5v14M5 12h14" />
        </svg>
    </button>
</div>
