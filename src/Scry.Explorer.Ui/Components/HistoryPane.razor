@namespace Scry

<div class="history-pane" data-testid="history-pane">
    <div class="pane-toolbar">
        <input class="pane-search"
               data-testid="history-search"
               type="search"
               placeholder="Search history…"
               aria-label="Search history"
               @bind="filter"
               @bind:event="oninput" />
        <button type="button"
                class="icon-btn"
                data-testid="history-clear"
                disabled="@(Store.Count == 0)"
                title="Forget every remembered query. Favorites are kept. The history is this browser's alone — nothing is sent to the server."
                @onclick="OnClear">Clear</button>
    </div>

    @if (Store.Count == 0)
    {
        <p class="pane-empty muted">Nothing yet. A query is remembered once it runs.</p>
    }
    else
    {
        <ul class="history-list" data-testid="history">
            @foreach (var item in Store.Items.Where(_ => HistoryStore.Matches(_, filter)))
            {
                var current = item;
                <li class="history-row @(current.Favorite ? "favorite" : null)" @key="current.Query">
                    @if (editing == current.Query)
                    {
                        <input class="history-label-input"
                               data-testid="history-label-input"
                               @ref="labelInput"
                               @bind="labelText"
                               @bind:event="oninput"
                               @onkeydown="_ => OnLabelKey(_, current.Query)"
                               @onblur="CancelEdit" />
                    }
                    else
                    {
                        @*
                            The entry is the link that loads the query back into the editor, and the
                            actions sit beside it rather than on it: a button inside an anchor is not
                            markup a browser has to make sense of.
                        *@
                        <button type="button"
                                class="history-item"
                                data-testid="history-item"
                                title="@current.Query"
                                @onclick="() => OnSelect.InvokeAsync(current.Query)">@HistoryStore.DisplayText(current)</button>
                        <span class="history-actions">
                            <button type="button" class="icon-btn" data-testid="history-label"
                                    aria-label="Name this query" title="Name this query"
                                    @onclick="() => StartEdit(current)">
                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"
                                     stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
                                    <path d="M12 20h9M16.5 3.5a2.1 2.1 0 0 1 3 3L7 19l-4 1 1-4z" />
                                </svg>
                            </button>
                            <button type="button" class="icon-btn @(current.Favorite ? "active" : null)"
                                    data-testid="history-favorite"
                                    aria-label="@(current.Favorite ? "Remove favorite" : "Keep this query")"
                                    title="@(current.Favorite ? "Remove favorite. It goes back under the cap." : "Keep this query. Favorites are never evicted.")"
                                    @onclick="() => OnFavorite.InvokeAsync((current.Query, !current.Favorite))">
                                <svg viewBox="0 0 24 24" fill="@(current.Favorite ? "currentColor" : "none")"
                                     stroke="currentColor" stroke-width="1.5" stroke-linecap="round"
                                     stroke-linejoin="round" aria-hidden="true" focusable="false">
                                    <path d="m12 2 3.1 6.3 6.9 1-5 4.9 1.2 6.8L12 17.8 5.8 21l1.2-6.8-5-4.9 6.9-1z" />
                                </svg>
                            </button>
                            <button type="button" class="icon-btn history-remove" data-testid="history-remove"
                                    aria-label="Forget this query" title="Forget this query."
                                    @onclick="() => OnRemove.InvokeAsync(current.Query)">
                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"
                                     stroke-linecap="round" aria-hidden="true" focusable="false">
                                    <path d="M6 6l12 12M18 6L6 18" />
                                </svg>
                            </button>
                        </span>
                    }
                </li>
            }
        </ul>
    }
</div>

@code
{
    [Parameter]
    [EditorRequired]
    public HistoryStore Store { get; set; } = null!;

    [Parameter]
    public EventCallback<string> OnSelect { get; set; }

    [Parameter]
    public EventCallback<string> OnRemove { get; set; }

    [Parameter]
    public EventCallback OnClear { get; set; }

    [Parameter]
    public EventCallback<(string Query, string Label)> OnLabel { get; set; }

    [Parameter]
    public EventCallback<(string Query, bool Favorite)> OnFavorite { get; set; }

    ElementReference labelInput;
    string? editing;
    string labelText = "";
    string? filter;
    bool focusPending;

    void StartEdit(HistoryItem item)
    {
        editing = item.Query;
        labelText = item.Label ?? "";
        focusPending = true;
    }

    // Escape cancels. GraphiQL commits on Escape, which loses whatever the label was before the edit
    // started — there is no way back from that, so the cancel is the safer of the two.
    async Task OnLabelKey(KeyboardEventArgs args, string query)
    {
        if (args.Key == "Enter")
        {
            editing = null;
            await OnLabel.InvokeAsync((query, labelText));
            return;
        }

        if (args.Key == "Escape")
        {
            CancelEdit();
        }
    }

    void CancelEdit() =>
        editing = null;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!focusPending)
        {
            return;
        }

        focusPending = false;
        await labelInput.FocusAsync();
    }
}
