@namespace Scry

<DialogShell Title="Settings" TestId="settings-dialog" OnClose="OnClose">
    <section class="setting">
        <h3>Theme</h3>
        <div class="setting-choices">
            @foreach (var mode in modes)
            {
                <button type="button"
                        class="@ChoiceClass(mode)"
                        data-testid="theme-@mode"
                        aria-pressed="@Pressed(mode)"
                        @onclick="() => OnThemeSelected.InvokeAsync(mode)">@Label(mode)</button>
            }
        </div>
        <p class="setting-note muted">System follows the browser's own light/dark preference.</p>
    </section>

    <section class="setting">
        <h3>Stored data</h3>
        <button type="button" class="btn" data-testid="settings-clear" @onclick="Clear">@clearLabel</button>
        <p class="setting-note muted">
            Forgets this browser's tabs, history, pane sizes and theme. Nothing here was ever sent to
            the server, and nothing outside the explorer's own keys is touched.
        </p>
    </section>
</DialogShell>
