@namespace Scry

@*
    The output column's tab strip. A tab exists only when there is something behind it, so a refused
    run leaves no tabs at all rather than three empty panes — which is also what keeps the "clears the
    panes" assertions meaningful.
*@
<div class="output-tabs" role="tablist" data-testid="output-tabs" aria-label="Result views">
    @foreach (var tab in Available)
    {
        <button type="button"
                class="@TabClass(tab)"
                data-testid="output-tab-@Slug(tab)"
                role="tab"
                aria-selected="@Selected(tab)"
                @onclick="() => OnSelect.InvokeAsync(tab)">@Label(tab)</button>
    }
</div>
