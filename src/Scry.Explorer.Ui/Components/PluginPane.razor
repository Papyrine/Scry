@namespace Scry

<aside class="plugin-pane" style="@Style" data-testid="plugin-pane"
       aria-label="@Title">
    <div class="plugin-title">@Title</div>
    @if (ShowsSchema)
    {
        @if (index is null)
        {
            <p class="pane-empty muted">Loading schema…</p>
        }
        else
        {
            <SchemaPane Index="index" OnInsertQuery="OnInsertQuery" />
        }
    }
    else
    {
        <HistoryPane Store="History"
                     OnSelect="OnHistorySelect"
                     OnRemove="OnHistoryRemove"
                     OnClear="OnHistoryClear"
                     OnLabel="OnHistoryLabel"
                     OnFavorite="OnHistoryFavorite" />
    }
</aside>
