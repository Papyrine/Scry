<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>netstandard2.0;net10.0</TargetFrameworks>
    <IsRoslynComponent>true</IsRoslynComponent>
    <EnforceExtendedAnalyzerRules>true</EnforceExtendedAnalyzerRules>
    <IsPackable>false</IsPackable>
    <!-- Track the package version so each release ships a distinct assembly identity;
         otherwise Rider's analyzer host caches a frozen generator and serves stale
         generated code after a consumer upgrades. Safe for a Roslyn component (never
         referenced at runtime). AssemblyVersion is numeric-only, so any prerelease
         suffix is stripped — note that means 1.0.0-beta.1 and 1.0.0-beta.2 share an
         identity, and Rider may need a restart when moving between them. -->
    <AssemblyVersion>$([System.Text.RegularExpressions.Regex]::Replace('$(Version)', '-.*$', ''))</AssemblyVersion>
    <!-- RS1035: the generator deliberately reads the model DLL from disk (the path-not-reference
         design). RS1041: target-framework guidance for analyzers. -->
    <NoWarn>$(NoWarn);RS1041;RS1035</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <!-- The stamp must be byte-identical between generated clients and the server; both compile the
         same shared source. -->
    <Compile Include="..\Shared\SchemaStamp.cs" Link="SchemaStamp.cs" />
    <PackageReference Include="Polyfill" PrivateAssets="all" />
    <PackageReference Include="ProjectDefaults" PrivateAssets="all" />
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" />
    <PackageReference Include="Microsoft.CodeAnalysis.Analyzers" PrivateAssets="all" />
    <!-- System.Reflection.Metadata / System.Collections.Immutable flow transitively from
         Microsoft.CodeAnalysis and are always provided by the analyzer host at runtime. -->
  </ItemGroup>
</Project>
