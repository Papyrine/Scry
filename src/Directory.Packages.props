<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
  </PropertyGroup>
  <!-- The query explorer's page cannot run on net11 (see the note on Microsoft.CodeAnalysis below), so it
       and what it hosts build for net10 too: Scry.Wire and Scry.Client target both, and
       Scry.Explorer.Core/.Ui/.Tests net10 alone. The 11.0.0 packages carry no net10 build, so a net10
       build takes the 10.0.x line instead. Pinned because PackageUpdate does not look at target
       frameworks: it would move these to 11.0.0 and fail the restore. NuGet audit still reports one
       that falls behind a security fix, and that is the time to bump it. -->
  <ItemGroup Condition="'$(TargetFramework)' == 'net10.0'">
    <PackageVersion Include="Microsoft.AspNetCore.Components.Web" Version="10.0.15" Pinned="true" />
    <PackageVersion Include="Microsoft.AspNetCore.Components.WebAssembly" Version="10.0.15" Pinned="true" />
    <PackageVersion Include="Microsoft.AspNetCore.Components.WebAssembly.DevServer" Version="10.0.15" Pinned="true" />
  </ItemGroup>
  <ItemGroup Condition="'$(TargetFramework)' != 'net10.0'">
    <PackageVersion Include="Microsoft.AspNetCore.Components.Web" Version="11.0.0" />
    <PackageVersion Include="Microsoft.AspNetCore.Components.WebAssembly" Version="11.0.0" />
    <PackageVersion Include="Microsoft.AspNetCore.Components.WebAssembly.DevServer" Version="11.0.0" />
  </ItemGroup>
  <ItemGroup>
    <PackageVersion Include="Microsoft.AspNetCore.Mvc.Testing" Version="11.0.0" />
    <PackageVersion Include="Microsoft.AspNetCore.TestHost" Version="11.0.0" />
    <!-- Scry.Client.SignalR's one dependency. The server half needs none: a hub is the shared framework's. -->
    <PackageVersion Include="Microsoft.AspNetCore.SignalR.Client" Version="11.0.0" />
    <!-- The change backplanes' one dependency each. Nothing else Scry ships references any of them. -->
    <PackageVersion Include="StackExchange.Redis" Version="3.4.35" />
    <PackageVersion Include="MessagePipe" Version="1.8.2" />
    <PackageVersion Include="NServiceBus" Version="10.2.10" />
    <PackageVersion Include="MassTransit" Version="9.3.0" />
    <PackageVersion Include="Rebus" Version="8.10.0" />
    <PackageVersion Include="Rebus.ServiceProvider" Version="10.8.0" />
    <PackageVersion Include="WolverineFx" Version="6.64.2" />
    <!-- Core Wolverine no longer compiles handler chains at runtime. The adapter needs neither; the tests
         run in dynamic mode, so they bring the compiler. A host picks this or static codegen itself. -->
    <PackageVersion Include="WolverineFx.RuntimeCompilation" Version="6.64.2" />
    <!-- Scry.Server.Mcp's one dependency: the official MCP SDK's streamable-HTTP server. -->
    <PackageVersion Include="ModelContextProtocol.AspNetCore" Version="2.4.0" />
    <PackageVersion Include="Delta.EF" Version="10.0.0" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore" Version="11.0.0" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.SqlServer" Version="11.0.0" />
    <!-- Scry.Server.Disclosure.SqlServer's one dependency. At the version EfLocalDb already brings to
         the tests, so that pinning it here moves nothing else in the tree. -->
    <PackageVersion Include="Microsoft.Data.SqlClient" Version="7.1.2" />
    <PackageVersion Include="EfLocalDb" Version="28.1.0" />
    <!-- Pinned only to lift Microsoft.Data.SqlClient's vulnerable transitive (GHSA-846f-f764-76mx,
         GHSA-2fmv-rv2c-59x7). Drop it once SqlClient depends on a patched version. -->
    <PackageVersion Include="System.Security.Cryptography.Pkcs" Version="11.0.0" />
    <!-- Pinned to 5.3.0 (do not bump without running the Explorer UI tests). 5.6.0 is the next published
         version — nuget.org has no 5.4.x/5.5.x — and it calls System.Threading.Volatile.ReadBarrier, which
         the net10 mono-wasm interpreter does not implement: the managed fallback recurses into itself and
         kills the Blazor WASM explorer with a fatal, uncatchable StackOverflowException the first time
         in-browser completion runs. RunAOTCompilation is off in Scry.Explorer.Ui (the interpreter is
         required for QueryTranslator's Expression.Compile), which is exactly where the intrinsic breaks.

         That intrinsic is fixed by dotnet/runtime#124538 (issue dotnet/runtime#124477) and ships in .NET 11
         — but do NOT reach for net11 as the way out for the explorer's page, which is why it alone stays on
         net10 while the rest of the tree is on net11. Verified against 11.0.0 (GA): the barrier crash is
         gone, and Roslyn still cannot run in the browser, for two further reasons, both filed:
           dotnet/roslyn#84615    AdhocWorkspace.AddProject takes a blocking SemaphoreSlim.Wait, which net11
                                  rejects on single-threaded wasm. Reproduces on 5.3.0 too, so pinning is no
                                  defence — the explorer cannot even construct its workspace. No switch gets
                                  round it: that runtime's CoreLib compiles IsMultithreadingSupported to a
                                  constant false, and SemaphoreSlim.WaitCore throws on it unconditionally.
           dotnet/runtime#128601  WasmEnableThreads=true, the documented way to permit blocking waits: the
                                  runtime loads (cross-origin isolated, with its workers), and Blazor then
                                  never renders. Filed as #131311, closed as a duplicate of this one.
         Stay on net10 + 5.3.0 until both are resolved.

         Mind the blind spot common to all three: the in-process Roslyn layer (Scry.Explorer.Tests, desktop
         CoreCLR) is unaffected by every one of them, so `dotnet test` on src/ stays green and hides the
         breakage. Only the Explorer UI tests in samples/Sample.Tests catch it, and they present as timeouts
         rather than errors. -->
    <PackageVersion Include="Microsoft.CodeAnalysis.CSharp" Version="5.3.0" Pinned="true" />
    <PackageVersion Include="Microsoft.CodeAnalysis.CSharp.Features" Version="5.3.0" Pinned="true" />
    <PackageVersion Include="Microsoft.CodeAnalysis.CSharp.Workspaces" Version="5.3.0" Pinned="true" />
    <PackageVersion Include="Microsoft.CodeAnalysis.Analyzers" Version="5.3.0" Pinned="true" />
    <!-- The same pin, for the parts of Roslyn only WolverineFx.RuntimeCompilation brings in, and only to
         Scry.Server.Bus.Tests: Wolverine compiles its handler chains at runtime, and without these two the
         runtime compiler's own floor of 5.0.0 would resolve the rest of the family off the pin. -->
    <PackageVersion Include="Microsoft.CodeAnalysis" Version="5.3.0" Pinned="true" />
    <PackageVersion Include="Microsoft.CodeAnalysis.Scripting" Version="5.3.0" Pinned="true" />
    <PackageVersion Include="Basic.Reference.Assemblies.Net100" Version="1.8.15" />
    <PackageVersion Include="BlazorMonaco" Version="3.5.0" />
    <PackageVersion Include="TUnit" Version="1.87.12" />
    <PackageVersion Include="Verify" Version="33.7.1" />
    <PackageVersion Include="Verify.TUnit" Version="33.7.1" />
    <PackageVersion Include="Verify.SourceGenerators" Version="2.5.0" />
    <PackageVersion Include="HttpMultipart" Version="1.1.0" />
    <PackageVersion Include="Polyfill" Version="11.4.5" />
    <PackageVersion Include="ProjectDefaults" Version="1.0.190" />
    <PackageVersion Include="MarkdownSnippets.MsBuild" Version="30.0.1" />
    <PackageVersion Include="NaughtyStrings" Version="3.0.0" />
    <PackageVersion Include="BenchmarkDotNet" Version="0.15.8" />
    <PackageVersion Include="DiffEngine" Version="21.2.0" />
  </ItemGroup>
</Project>