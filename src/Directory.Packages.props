<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
  </PropertyGroup>
  <ItemGroup>
    <PackageVersion Include="Microsoft.AspNetCore.Components.Web" Version="10.0.12" />
    <PackageVersion Include="Microsoft.AspNetCore.Components.WebAssembly" Version="10.0.12" />
    <PackageVersion Include="Microsoft.AspNetCore.Components.WebAssembly.DevServer" Version="10.0.12" />
    <PackageVersion Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.12" />
    <!-- Scry.Client.SignalR's one dependency. The server half needs none: a hub is the shared framework's. -->
    <PackageVersion Include="Microsoft.AspNetCore.SignalR.Client" Version="10.0.12" />
    <!-- The change backplanes' one dependency each. Nothing else Scry ships references any of them. -->
    <PackageVersion Include="StackExchange.Redis" Version="3.3.1" />
    <PackageVersion Include="MessagePipe" Version="1.8.2" />
    <PackageVersion Include="NServiceBus" Version="10.2.9" />
    <!-- 8.x on purpose: the 8.5 line is the last under Apache-2.0, and MassTransit 9 needs a commercial
         licence. Do not move it to 9 without deciding that. -->
    <PackageVersion Include="MassTransit" Version="8.5.10" />
    <PackageVersion Include="Rebus" Version="8.9.4" />
    <PackageVersion Include="Rebus.ServiceProvider" Version="10.7.2" />
    <PackageVersion Include="WolverineFx" Version="6.39.1" />
    <!-- Core Wolverine no longer compiles handler chains at runtime. The adapter needs neither; the tests
         run in dynamic mode, so they bring the compiler. A host picks this or static codegen itself. -->
    <PackageVersion Include="WolverineFx.RuntimeCompilation" Version="6.39.1" />
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.12" />
    <PackageVersion Include="Delta.EF" Version="9.0.1" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore" Version="10.0.12" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.SqlServer" Version="10.0.12" />
    <PackageVersion Include="EfLocalDb" Version="26.2.0" />
    <!-- Pinned to 5.3.0 (do not bump without running the Explorer UI tests). 5.6.0 is the next published
         version — nuget.org has no 5.4.x/5.5.x — and it calls System.Threading.Volatile.ReadBarrier, which
         the net10 mono-wasm interpreter does not implement: the managed fallback recurses into itself and
         kills the Blazor WASM explorer with a fatal, uncatchable StackOverflowException the first time
         in-browser completion runs. RunAOTCompilation is off in Scry.Explorer.Ui (the interpreter is
         required for QueryTranslator's Expression.Compile), which is exactly where the intrinsic breaks.

         That intrinsic is fixed by dotnet/runtime#124538 (issue dotnet/runtime#124477) and ships in .NET 11
         — but do NOT reach for net11 as the way out. Verified against 11.0.0-preview.6: the barrier crash is
         gone, and Roslyn still cannot run in the browser, for two further reasons, both filed:
           dotnet/roslyn#84615    AdhocWorkspace.AddProject takes a blocking SemaphoreSlim.Wait, which net11
                                  rejects on single-threaded wasm. Reproduces on 5.3.0 too, so pinning is no
                                  defence — the explorer cannot even construct its workspace.
           dotnet/runtime#131311  WasmEnableThreads=true, the documented way to permit blocking waits, makes
                                  the net11 runtime fail to start at all.
         Stay on net10 + 5.3.0 until both are resolved.

         Mind the blind spot common to all three: the in-process Roslyn layer (Scry.Explorer.Tests, desktop
         CoreCLR) is unaffected by every one of them, so `dotnet test` on src/ stays green and hides the
         breakage. Only the Explorer UI tests in samples/Sample.Tests catch it, and they present as timeouts
         rather than errors. -->
    <PackageVersion Include="Microsoft.CodeAnalysis.CSharp" Version="5.3.0" Pinned="true" />
    <PackageVersion Include="Microsoft.CodeAnalysis.CSharp.Features" Version="5.3.0" Pinned="true" />
    <PackageVersion Include="Microsoft.CodeAnalysis.CSharp.Workspaces" Version="5.3.0" Pinned="true" />
    <PackageVersion Include="Microsoft.CodeAnalysis.Analyzers" Version="5.3.0" Pinned="true" />
    <!-- The same pin, for the parts of Roslyn only WolverineFx.RuntimeCompilation brings in, and only to
         Scry.Server.Bus.Tests: Wolverine compiles its handler chains at runtime, and without these two the
         runtime compiler's own floor of 5.0.0 would resolve the rest of the family off the pin. -->
    <PackageVersion Include="Microsoft.CodeAnalysis" Version="5.3.0" Pinned="true" />
    <PackageVersion Include="Microsoft.CodeAnalysis.Scripting" Version="5.3.0" Pinned="true" />
    <PackageVersion Include="Basic.Reference.Assemblies.Net100" Version="1.8.12" />
    <PackageVersion Include="BlazorMonaco" Version="3.5.0" />
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.10.1" />
    <PackageVersion Include="NUnit" Version="4.6.1" />
    <PackageVersion Include="NUnit3TestAdapter" Version="6.3.0" />
    <PackageVersion Include="Verify" Version="33.1.2" />
    <PackageVersion Include="Verify.NUnit" Version="33.1.2" />
    <PackageVersion Include="Verify.DiffPlex" Version="3.3.1" />
    <PackageVersion Include="Verify.SourceGenerators" Version="2.5.0" />
    <PackageVersion Include="HttpMultipart" Version="0.1.4" />
    <PackageVersion Include="Polyfill" Version="11.4.0" />
    <PackageVersion Include="ProjectDefaults" Version="1.0.181" />
    <PackageVersion Include="MarkdownSnippets.MsBuild" Version="28.4.2" />
    <PackageVersion Include="NaughtyStrings" Version="3.0.0" />
    <PackageVersion Include="BenchmarkDotNet" Version="0.15.8" />
    <PackageVersion Include="DiffEngine" Version="20.5.0" />
  </ItemGroup>
</Project>