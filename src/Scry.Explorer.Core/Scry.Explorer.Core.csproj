<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <RootNamespace>Scry</RootNamespace>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <!-- Signed with the tree's own key so Scry.Client can name it as a friend: the client's vendored
         multipart reader is what this reads binary responses with, and a strong-named assembly cannot
         befriend an unsigned one. Directory.Build.targets supplies the key file. -->
    <SignAssembly>true</SignAssembly>
  </PropertyGroup>
  <!--
    The browser-Roslyn layer for the explorer: synthesizes the query models, hosts an AdhocWorkspace
    for completion/diagnostics/hover, and compiles+translates user snippets. Kept as its own library
    (not in Scry.Explorer.Ui) so it can be unit-tested in-process (no browser) and reused by the
    explorer's Web Worker host.
  -->
  <ItemGroup>
    <PackageReference Include="ProjectDefaults" PrivateAssets="all" />
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp.Features" />
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp.Workspaces" />
    <PackageReference Include="Basic.Reference.Assemblies.Net100" />
    <ProjectReference Include="..\Scry.Client\Scry.Client.csproj" />
    <ProjectReference Include="..\Scry.Wire\Scry.Wire.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- The synthesizer spells a member the way the generator does, keyword escaping included. -->
    <Compile Include="..\Shared\CSharpIdentifier.cs" Link="CSharpIdentifier.cs" />
  </ItemGroup>
</Project>
