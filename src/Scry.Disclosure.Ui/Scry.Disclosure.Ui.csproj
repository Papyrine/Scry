<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">
  <!--
    The disclosure explorer's page: a small Blazor WASM app over the JSON API that
    Scry.Server.Disclosure.Explorer maps. In no solution, and referencing no project — that package
    is its only builder (its EmbedDisclosureUi target publishes this and embeds the result), and a
    publish that shares no obj directory with the solution build cannot disturb it.

    Unlike the query explorer's page it hosts no compiler, so it is trimmed and its JSON is
    generated at build time.
  -->
  <PropertyGroup>
    <RootNamespace>Scry</RootNamespace>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <!-- Stable _framework file names. Fingerprinted names need an import map written into the page
         at publish time, which is an inline script the page's Content-Security-Policy would have to
         be told the hash of; and nothing is lost by going without, since every asset is revalidated
         against a tag made from its content. -->
    <WasmFingerprintAssets>false</WasmFingerprintAssets>
    <!-- Every time on the page is shown in UTC and every number as an invariant one (Show.cs), so it
         needs neither the globalization data nor the time zone database. Leaving out the time zone
         database relinks the runtime, which needs the wasm-tools-net10 workload (-net10 because the
         SDK is a major ahead of the target), and the relink drops the native code nothing calls:
         _framework is 5.5 MB rather than 7.2.
         Not AOT-compiled: that makes it 18 MB, to speed up a page that renders tables of JSON. -->
    <InvariantGlobalization>true</InvariantGlobalization>
    <InvariantTimezone>true</InvariantTimezone>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.DevServer" PrivateAssets="all" />
    <!-- What the page and the server say to each other, compiled into both. -->
    <Compile Include="..\Shared\Disclosure\*.cs" LinkBase="Shared" />
  </ItemGroup>
</Project>
