<?xml version="1.0" encoding="utf-8"?>
<Project>
  <!--
    Wires the Pneumatic source generator. A consuming project only needs to:
      1. Set <PneumaticModelDll> to the path of the server model's built DLL.
      2. Add a <ProjectReference ... ReferenceOutputAssembly="false" /> to the model project for
         build ordering (NOT a real reference).
    This props file surfaces the path to the generator and folds the DLL's content hash into a
    compiler-visible property so the generator re-reads it exactly when the model changes.
  -->
  <ItemGroup>
    <CompilerVisibleProperty Include="PneumaticModelDll" />
    <CompilerVisibleProperty Include="PneumaticModelStamp" />
  </ItemGroup>

  <Target Name="ComputePneumaticStamp"
          AfterTargets="ResolveProjectReferences"
          BeforeTargets="GenerateMSBuildEditorConfig;CoreCompile"
          Condition="'$(PneumaticModelDll)' != '' and Exists('$(PneumaticModelDll)')">
    <GetFileHash Files="$(PneumaticModelDll)" Algorithm="SHA256">
      <Output TaskParameter="Hash" PropertyName="PneumaticModelStamp" />
    </GetFileHash>
  </Target>

  <Target Name="EnsurePneumaticModel"
          BeforeTargets="CoreCompile"
          Condition="'$(PneumaticModelDll)' != '' and !Exists('$(PneumaticModelDll)')">
    <Error Text="Pneumatic: the model assembly '$(PneumaticModelDll)' was not found. Ensure the model project is referenced with ReferenceOutputAssembly=&quot;false&quot; so it builds first." />
  </Target>
</Project>
