<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <RootNamespace>Scry</RootNamespace>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <PackageReadmeFile>nuget-readme.md</PackageReadmeFile>
    <Description>Serves Scry to AI agents over MCP: the schema and queries, and optionally commands, under the same validation, policies and limits as every other client.</Description>
  </PropertyGroup>
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <PackageReference Include="ModelContextProtocol.AspNetCore" />
    <PackageReference Include="Microsoft.EntityFrameworkCore" />
    <PackageReference Include="ProjectDefaults" PrivateAssets="all" />
    <ProjectReference Include="..\Scry.Server\Scry.Server.csproj" />
    <None Include="nuget-readme.md" Pack="true" PackagePath="\" />
  </ItemGroup>
</Project>
