<Project Sdk="Microsoft.NET.Sdk">
  <!-- Writes a server's description from its model DLL, read as metadata as the source generator reads
       it, so a client in another language is generated at build time with no server started. A build
       runs it after the model is compiled (Sample.WebServer's WriteScryDescription target does). Not
       packed yet: the TypeScript client it serves is unpublished too. -->
  <PropertyGroup>
    <RootNamespace>Scry</RootNamespace>
    <OutputType>Exe</OutputType>
    <TargetFramework>net11.0</TargetFramework>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <!-- The generator's own reader and stamp, referenced as a library: the description has to be the
         one a client generated by it would be validated against. Nothing called here touches Roslyn. -->
    <ProjectReference Include="..\Scry.SourceGenerator\Scry.SourceGenerator.csproj" />
    <ProjectReference Include="..\Scry.Wire\Scry.Wire.csproj" />
    <!-- ModelDescriptionTests compares what this writes with what the server describes. -->
    <InternalsVisibleTo Include="Scry.Tests" Key="$(ScryPublicKey)" />
    <!-- No Polyfill: the generator's net10 build carries its own, internal and visible here, which
         would collide with the type forwards Polyfill adds on net11. Nothing here needs one. -->
    <PackageReference Include="ProjectDefaults" PrivateAssets="all" />
  </ItemGroup>
</Project>
