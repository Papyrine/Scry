@page "/"
@inject ScryQuery Query

<PageTitle>Scry Sample</PageTitle>

<h1>Scry Sample</h1>
<p><a href="/scry">Explorer</a> · <a href="/paging">Paging</a> · <a href="/keyset">Keyset</a> · <a href="/permissions">Cached policy</a></p>
<p>
    These tables are produced by writing ordinary LINQ in the browser. Scry serializes the query,
    sends it to the server, executes it against EF Core, and returns only the requested shape.
</p>

@if (error is not null)
{
    <p class="error" role="alert">@error</p>
}

<!-- begin-snippet: staleDataMarkup -->
@if (stale)
{
    <p class="stale" role="alert">
        This page needs a newer version of the app. Use the reload prompt above to update.
    </p>
}
<!-- end-snippet -->


<h2>Active employees</h2>
@if (employees is null)
{
    <p>Loading…</p>
}
else
{
    <table>
        <thead>
            <tr><th>Name</th><th>Status</th><th>Manager</th><th>Department</th></tr>
        </thead>
        <tbody>
        @foreach (var row in employees)
        {
            <tr>
                <td>@row.Name</td>
                <td>@row.Status</td>
                <td>@(row.Manager ?? "—")</td>
                <td>@row.Department</td>
            </tr>
        }
        </tbody>
    </table>
}

<h2>Employee photos (attachments)</h2>
<p>
    Each face is an <code>[Attachment]</code>: the query behind this section carried a handle keyed
    by the row rather than the bytes, so the names render before a single image is asked for. Every
    face below is then a request of its own, authorized on its own terms. Carol's row holds no photo,
    which is an answer about that row rather than a refusal — and costs no download.
</p>
@if (photos is null)
{
    <p>Loading…</p>
}
else
{
    <div class="faces" data-testid="faces" data-fetched="@(facesFetched ? "true" : "false")">
        @foreach (var photo in photos)
        {
            <figure class="face">
                @if (faces.TryGetValue(photo.Id, out var face))
                {
                    <img src="@face" alt="@photo.Name" width="64" height="64" data-testid="face" />
                }
                else
                {
                    <div class="face-empty" data-testid="face-empty">@(facesFetched ? "no photo" : "…")</div>
                }
                <figcaption>@photo.Name</figcaption>
            </figure>
        }
    </div>
}

