<Window x:Class="Sample.WpfClient.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Scry - WPF sample" Height="480" Width="760">
  <DockPanel Margin="12">
    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8">
      <Button x:Name="RefreshButton" Content="Refresh" Padding="16,4" Click="OnRefreshClick" />
      <CheckBox x:Name="LiveCheckBox" Content="Live" Margin="12,0,0,0" VerticalAlignment="Center"
                Checked="OnLiveChanged" Unchecked="OnLiveChanged" />
      <TextBlock x:Name="StatusText" Margin="12,0,0,0" VerticalAlignment="Center" TextWrapping="Wrap" />
    </StackPanel>
    <!-- begin-snippet: wpfCommandMarkup -->
    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8">
      <TextBox x:Name="RenameText" Text="Renamed" Width="200" VerticalContentAlignment="Center" />
      <Button Content="Rename selected" Padding="16,4" Margin="8,0,0,0" Command="{Binding Rename}" />
    </StackPanel>
    <!-- end-snippet -->
    <DataGrid x:Name="EmployeeGrid" AutoGenerateColumns="True" IsReadOnly="True" SelectionMode="Single"
              HeadersVisibility="Column" GridLinesVisibility="Horizontal"
              AutoGeneratingColumn="OnAutoGeneratingColumn" />
  </DockPanel>
</Window>
