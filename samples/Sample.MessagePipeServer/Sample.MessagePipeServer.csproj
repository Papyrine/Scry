<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <!-- One database for two nodes, the registration the model needs, and a write to watch arrive:
         shared by every backplane sample, so Program.cs holds only the backplane. -->
    <Compile Include="..\Shared\BackplaneHost.cs" Link="BackplaneHost.cs" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" />
    <PackageReference Include="EfLocalDb" />
    <!-- The transport is the host's choice and MessagePipe's to provide. Redis here, because it is
         the one of MessagePipe's that lets every node both publish and subscribe. -->
    <PackageReference Include="MessagePipe.Redis" />
    <!-- Referenced only to lift what MessagePipe.Redis brings in past the version with advisories. -->
    <PackageReference Include="MessagePack" />
    <ProjectReference Include="..\..\src\Scry.Server\Scry.Server.csproj" />
    <ProjectReference Include="..\..\src\Scry.Server.MessagePipe\Scry.Server.MessagePipe.csproj" />
    <ProjectReference Include="..\Sample.Model\Sample.Model.csproj" />
    <ProjectReference Include="..\Sample.CommandHandlers\Sample.CommandHandlers.csproj" />
  </ItemGroup>
</Project>
