<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net11.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" />
    <PackageReference Include="EfLocalDb" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.Server" />
    <PackageReference Include="OpenTelemetry.Extensions.Hosting" />
    <ProjectReference Include="..\..\src\Scry.Server\Scry.Server.csproj" />
    <ProjectReference Include="..\..\src\Scry.Server.Delta\Scry.Server.Delta.csproj" />
    <ProjectReference Include="..\..\src\Scry.Server.Explorer\Scry.Server.Explorer.csproj" />
    <ProjectReference Include="..\..\src\Scry.Server.SignalR\Scry.Server.SignalR.csproj" />
    <ProjectReference Include="..\..\src\Scry.Server.Mcp\Scry.Server.Mcp.csproj" />
    <ProjectReference Include="..\Sample.Model\Sample.Model.csproj" />
    <ProjectReference Include="..\Sample.CommandHandlers\Sample.CommandHandlers.csproj" />
    <ProjectReference Include="..\Sample.WebClient\Sample.WebClient.csproj" />
    <!-- Build ordering only: WriteScryDescription below runs it. -->
    <ProjectReference Include="..\..\src\Scry.Describe\Scry.Describe.csproj" ReferenceOutputAssembly="false" />
  </ItemGroup>

  <!-- The description the TypeScript samples generate their clients from, written from the model DLL as
       this project builds, so no server has to start for it: one run per sample. MaxPageSize is the one
       option Program.cs sets that a description carries, so it is said again here. -->
  <!-- begin-snippet: describeAtBuildTime -->
  <Target Name="WriteScryDescription" AfterTargets="Build">
    <MSBuild Projects="..\..\src\Scry.Describe\Scry.Describe.csproj" Targets="GetTargetPath">
      <Output TaskParameter="TargetOutputs" PropertyName="ScryDescribe" />
    </MSBuild>
    <PropertyGroup>
      <ScryModel>$(TargetDir)Sample.Model.dll</ScryModel>
      <ScryDescribeCommand>dotnet &quot;$(ScryDescribe)&quot; --model &quot;$(ScryModel)&quot; --max-page-size 200</ScryDescribeCommand>
    </PropertyGroup>
    <ItemGroup>
      <ScryDescription Include="..\Sample.TypeScriptClient\scry.description.json" />
      <ScryDescription Include="..\Sample.TypeScriptWeb\scry.description.json" />
    </ItemGroup>
    <Exec Command="$(ScryDescribeCommand) --output &quot;%(ScryDescription.FullPath)&quot;" />
  </Target>
  <!-- end-snippet -->
</Project>
