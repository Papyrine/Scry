@page "/"
@inject ScryQuery Query

<PageTitle>Scry Sample</PageTitle>

<h1>Scry Sample</h1>
<p><a href="/scry">Explorer</a> · <a href="/paging">Paging</a></p>
<p>
    These tables are produced by writing ordinary LINQ in the browser. Scry serializes the query,
    sends it to the server, executes it against EF Core, and returns only the requested shape.
</p>

@if (error is not null)
{
    <p class="error" role="alert">@error</p>
}

<h2>Active employees</h2>
@if (employees is null)
{
    <p>Loading…</p>
}
else
{
    <table>
        <thead>
            <tr><th>Name</th><th>Status</th><th>Manager</th><th>Department</th></tr>
        </thead>
        <tbody>
        @foreach (var row in employees)
        {
            <tr>
                <td>@row.Name</td>
                <td>@row.Status</td>
                <td>@(row.Manager ?? "—")</td>
                <td>@row.Department</td>
            </tr>
        }
        </tbody>
    </table>
}

<h2>Orders by region</h2>
@if (regions is null)
{
    <p>Loading…</p>
}
else
{
    <table>
        <thead>
            <tr><th>Region</th><th>Total</th><th>Orders</th></tr>
        </thead>
        <tbody>
        @foreach (var region in regions)
        {
            <tr><td>@region.Region</td><td>@region.Total</td><td>@region.Count</td></tr>
        }
        </tbody>
    </table>
}

<h2>@status full-timers (top @top)</h2>
@if (fullTimers is null)
{
    <p>Loading…</p>
}
else
{
    <table>
        <thead>
            <tr><th>Name</th><th>Manager</th><th>Department</th></tr>
        </thead>
        <tbody>
        @foreach (var row in fullTimers)
        {
            <tr><td>@row.Name</td><td>@(row.Manager ?? "—")</td><td>@row.Department</td></tr>
        }
        </tbody>
    </table>
}

<h2>Employee cards (nested projection)</h2>
@if (cards is null)
{
    <p>Loading…</p>
}
else
{
    <table>
        <thead>
            <tr><th>Name</th><th>Department</th></tr>
        </thead>
        <tbody>
        @foreach (var card in cards)
        {
            <tr><td>@card.Name</td><td>@card.Department.Name</td></tr>
        }
        </tbody>
    </table>
}
