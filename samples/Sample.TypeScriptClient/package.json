{
  "name": "sample-typescript-client",
  "version": "0.0.0",
  "private": true,
  "description": "A console client for Sample.WebServer in TypeScript: the queries Sample.ConsoleClient writes in C#.",
  "type": "module",
  "engines": {
    "node": ">=23.6"
  },
  "scripts": {
    "generate": "scry-codegen --input scry.description.json --output src/scry.generated.ts",
    "generate:snapshot": "scry-codegen --input ../Sample.Tests/UiSnapshotTests.ExplorerIntrospectionEndpoint.verified.txt --output src/scry.generated.ts",
    "start": "node src/main.ts",
    "typecheck": "tsc -p ."
  },
  "dependencies": {
    "scry-client": "file:../../clients/typescript"
  },
  "devDependencies": {
    "@types/node": "^26.6.11",
    "typescript": "^7.0.2"
  }
}
