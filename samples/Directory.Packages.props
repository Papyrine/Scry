<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>
  <ItemGroup>
    <!-- work around CVE -->
    <PackageVersion Include="AngleSharp" Version="1.8.2" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore" Version="10.0.12" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.SqlServer" Version="10.0.12" />
    <PackageVersion Include="EfLocalDb" Version="26.2.0" />
    <PackageVersion Include="Delta.EF" Version="9.0.1" />
    <PackageVersion Include="Microsoft.AspNetCore.Components.WebAssembly" Version="10.0.12" />
    <PackageVersion Include="Microsoft.AspNetCore.Components.WebAssembly.DevServer" Version="10.0.12" />
    <PackageVersion Include="Microsoft.AspNetCore.Components.WebAssembly.Server" Version="10.0.12" />
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection" Version="10.0.12" />
    <PackageVersion Include="Microsoft.Extensions.Http" Version="10.0.12" />
    <PackageVersion Include="OpenTelemetry.Extensions.Hosting" Version="1.19.1" />
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.10.1" />
    <PackageVersion Include="NUnit" Version="4.6.1" />
    <PackageVersion Include="NUnit3TestAdapter" Version="6.3.0" />
    <PackageVersion Include="Microsoft.AspNetCore.TestHost" Version="10.0.12" />
    <PackageVersion Include="Microsoft.Playwright" Version="1.63.0" />
    <PackageVersion Include="Verify.NUnit" Version="33.1.4" />
    <PackageVersion Include="Verify.AngleSharp" Version="5.1.2" />
    <PackageVersion Include="Verify.DiffPlex" Version="3.3.1" />
    <PackageVersion Include="Verify.Bunit" Version="14.1.0" />
    <PackageVersion Include="Verify.Playwright" Version="3.1.1" />
    <PackageVersion Include="Verify.Http" Version="7.5.1" />
    <PackageVersion Include="DiffEngine" Version="20.5.1" />
    <!-- Under central package management the F# SDK drops its implicit FSharp.Core reference, so the
         F# projects reference it by hand and the version lives here like any other. -->
    <PackageVersion Include="FSharp.Core" Version="10.1.401" />
    <!-- What the live-query samples show Scry working with. Neither is referenced by anything Scry
         ships: a live query is an IAsyncEnumerable, a callback, or a BCL IObservable, and these are
         what a consumer who already uses them plugs those into. -->
    <PackageVersion Include="System.Reactive" Version="7.0.0" />
    <PackageVersion Include="MessagePipe" Version="1.8.2" />
    <!-- The transport under Sample.MessagePipeServer. MessagePipe's own, chosen by the host. -->
    <PackageVersion Include="MessagePipe.Redis" Version="1.8.2" />
    <!-- work around CVE: MessagePipe.Redis asks for MessagePack 3.1.4, which carries known advisories -->
    <PackageVersion Include="MessagePack" Version="3.1.10" />
  </ItemGroup>
</Project>