<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
  </PropertyGroup>
  <ItemGroup>
    <!-- Not referenced: pins what Microsoft.Data.SqlClient brings, which GHSA-846f-f764-76mx and
         GHSA-2fmv-rv2c-59x7 cover up to 9.0.20. Remove once SqlClient asks for a patched one itself. -->
    <PackageVersion Include="System.Security.Cryptography.Pkcs" Version="9.0.21" />
    <PackageVersion Include="TUnit" Version="1.75.0" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.SqlServer" Version="10.0.13" />
    <PackageVersion Include="EfLocalDb" Version="27.2.5" />
    <!-- Pinned only to lift Microsoft.Data.SqlClient's vulnerable transitive (GHSA-846f-f764-76mx,
         GHSA-2fmv-rv2c-59x7). Drop it once SqlClient depends on a patched version. -->
    <PackageVersion Include="System.Security.Cryptography.Pkcs" Version="10.0.13" />
    <PackageVersion Include="Microsoft.AspNetCore.TestHost" Version="10.0.13" />
  </ItemGroup>
</Project>
